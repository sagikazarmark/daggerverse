"""
Enum representing the kind of content.
"""
enum ContentKind {
  TUTORIAL
  CHALLENGE
  COURSE
  TRAINING
  VENDOR
}

type Labctl {
  let _container: Container!

  let sessionId: Secret
  let accessToken: Secret

  new(
    """
    Version (release tag) of labctl to download from GitHub. Defaults to "latest".
    """
    version: String! = "latest",
    """
    The container to use as the base for the labctl installation. Defaults to "alpine:latest".
    """
    container: Container! = Dagger.container.from("alpine:latest"),
    """
    The session ID for the labctl.
    """
    sessionId: Secret = null,
    """
    The access token for the labctl.
    """
    accessToken: Secret = null,
  ) {
    self._container = container
      .withFile(
        "/usr/local/bin/labctl",
        Dagger
          .container
          .from("alpine:latest")
          .withMountedFile("/tmp/labctl.tar.gz", Dagger.http(
            self.downloadUrl(version),
          ))
          .withExec(["tar", "xzf", "/tmp/labctl.tar.gz", "-C", "/tmp"])
          .file("/tmp/labctl"),
      )
      .withEntrypoint(["/usr/local/bin/labctl"])
      .withFile(
        "/root/.iximiuz/labctl/config.yaml",
        Dagger.file(
          "config.yaml",
          """
          base_url: https://labs.iximiuz.com
          api_base_url: https://labs.iximiuz.com/api
          plays_dir: /root/.iximiuz/labctl/plays
          ssh_identity_file: /root/.ssh/iximiuz_labs_user
          """,
        ),
      )

    self.sessionId = sessionId
    self.accessToken = accessToken

    self
  }

  """
  Returns the container with the labctl binary and configuration.
  """
  pub container: Container! {
    let container = self._container

    let sessionId = self.sessionId
    if (sessionId != null) {
      container = container.withSecretVariable("IXIMIUZ_SESSION_ID", sessionId)
    }

    let accessToken = self.accessToken
    if (accessToken != null) {
      container = container.withSecretVariable("IXIMIUZ_ACCESS_TOKEN", accessToken)
    }

    container
  }

  """
  Sets the session ID for labctl.
  """
  pub withSessionId(sessionId: Secret!): Labctl! {
    self.sessionId = sessionId

    self
  }

  """
  Sets the access token for labctl.
  """
  pub withAccessToken(accessToken: Secret!): Labctl! {
    self.accessToken = accessToken

    self
  }

  let downloadUrl(version: String!): String! {
    let osArch = toString(Dagger.defaultPlatform).trim("\"").replace("/", "_")

    let downloadURL = if (version == "latest") {
      "https://github.com/iximiuz/labctl/releases/latest/download/labctl_" + osArch + ".tar.gz"
    } else {
      "https://github.com/iximiuz/labctl/releases/download/v" + version.trimPrefix("v") + "/labctl_" + osArch + ".tar.gz"
    }
  }

  """
  Manage playgrounds.
  """
  pub playground(name: String!): Playground! {
    Playground(self.container, name)
  }

  """
  Manage tutorials.
  """
  pub tutorial(name: String!): Content! {
    Content(self.container, ContentKind.TUTORIAL, name)
  }

  """
  Manage challenges.
  """
  pub challenge(name: String!): Content! {
    Content(self.container, ContentKind.CHALLENGE, name)
  }

  """
  Manage courses.
  """
  pub course(name: String!): Content! {
    Content(self.container, ContentKind.COURSE, name)
  }

  """
  Manage training content.
  """
  pub training(name: String!): Content! {
    Content(self.container, ContentKind.TRAINING, name)
  }

  """
  Manage vendor content.
  """
  pub vendor(name: String!): Content! {
    Content(self.container, ContentKind.VENDOR, name)
  }

  """
  Manage any content.
  """
  pub content(kind: ContentKind!, name: String!): Content! {
    Content(self.container, kind, name)
  }
}

type Playground {
  let container: Container!
  let name: String!

  new(
    container: Container!,
    name: String!,
  ) {
    self.container = container
    self.name = name

    self
  }

  """
  Update an existing playground.
  """
  pub push(
    """
    Manifest file.
    """
    file: File = null,
    """
    Directory with the manifest file (and possibly other content files).
    """
    dir: Directory = null,
  ): Container! {
    if (file != null and dir != null) {
      raise "only one of file or dir must be provided"
    }

    let args = ["labctl", "playground", "update", self.name, "--force"]
    let container = self.container.withWorkdir("/work")

    if (file != null) {
      args += ["--file", "manifest.yaml"]
      container = container.withMountedFile("manifest.yaml", file)
    } else if (dir != null) {
      args += ["--dir", "."]
      container = container.withMountedDirectory(".", dir)
    } else {
      raise "either file or dir must be provided"
    }

    container.withExec(args)
  }
}

type Content {
  let container: Container!
  let kind: ContentKind!
  let name: String!

  new(
    container: Container!,
    kind: ContentKind!,
    name: String!,
  ) {
    self.container = container
    self.kind = kind
    self.name = name

    self
  }

  """
  Push content to the content repository.
  """
  pub push(
    """
    Directory with content files.
    """
    dir: Directory!,
  ): Container! {
    self
      .container
      .withWorkdir("/work")
      .withMountedDirectory(".", dir)
      .withExec(["labctl", "content", "push", toString(self.kind).toLower.trim("\""), self.name, "--force", "--dir", "."])
  }
}
