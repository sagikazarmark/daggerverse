type Tests {
  """
  Restate starts and the admin endpoint responds to `restate whoami`.
  """
  pub basic: Container! @check {
    restate
      .run
      .cli
      .withExec(["restate", "whoami"])
  }

  """
  Restate boots cleanly with a custom config file mounted via withConfig.
  """
  pub withConfig: Container! @check {
    let cfg = Dagger.file("server.toml", "default-num-partitions = 16\n")

    restate
      .withConfig(cfg)
      .run
      .cli
      .withExec(["restate", "whoami"])
  }

  """
  A config file attempting to override admin/ingress bind addresses is ignored.
  """
  pub portsLocked: String! @check {
    let badConfig = Dagger.file(
      "server.toml",
      """
      [admin]
      bind-address = "127.0.0.1:9999"

      [ingress]
      bind-address = "127.0.0.1:9999"
      """,
    )

    restate
      .withConfig(badConfig)
      .run
      .cli
      .withExec(["restate", "whoami"])
      .stdout
  }

  """
  A service can be registered against a running Restate.
  """
  pub registerDeployment: String! @check {
    let svc = container
      .from("ghcr.io/sagikazarmark/restate-examples:v0.1.0")
      .withExposedPort(9080)
      .asService(useEntrypoint: true)

    let _ = svc.start

    restate
      .run
      .registerDeployment(svc)
      .cli
      .withExec(["restate", "deployments", "list"])
      .stdout
  }

  """
  A registered deployment can be invoked through Restate's HTTP ingress.
  """
  pub invokeDeployment: String! @check {
    let svc = container
      .from("ghcr.io/sagikazarmark/restate-examples:v0.1.0")
      .withExposedPort(9080)
      .asService(useEntrypoint: true)

    let started = svc.start

    let facade = restate.run

    let _ = facade.registerDeployment(svc)

    container
      .from("curlimages/curl:8.11.1")
      .withServiceBinding("restate", facade.service)
      .withExec([
        "curl", "-fsS",
        "-X", "POST",
        "-H", "content-type: application/json",
        "-d", "\"World\"",
        "http://restate:8080/Greeter/greet",
      ])
      .stdout
  }

  """
  Two services can be registered against the same Restate instance and both
  show up in the deployments list (registrations accumulate).
  """
  pub registerDeploymentMultiple: String! @check {
    let svcA = container
      .from("ghcr.io/sagikazarmark/restate-examples:v0.1.0")
      .withExposedPort(9080)
      .asService(useEntrypoint: true)

    let svcB = container
      .from("ghcr.io/sagikazarmark/restate-examples:v0.1.0")
      .withExposedPort(9080)
      .asService(useEntrypoint: true)

    let _ = svcA.start
    let _ = svcB.start

    restate
      .run
      .registerDeployment(svcA)
      .registerDeployment(svcB)
      .cli
      .withExec(["restate", "deployments", "list"])
      .stdout
  }
}
